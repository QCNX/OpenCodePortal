# OpenCode Portal Gateway — copy to .env and fill in secrets.
#   cp .env.example .env
#
# Used by: node/tsx gateway startup (auto-loaded), docker compose (env_file).
# .env is gitignored — never commit real secrets.

# Authentik OIDC (when config.yaml references ${OIDC_CLIENT_ID} / ${OIDC_CLIENT_SECRET})
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional break-glass token (if config.yaml uses sharedSecret: "${OCP_SHARED_SECRET}")
# OCP_SHARED_SECRET=ocp-sk-...

# Optional private Agent image override for Dashboard deploy instructions.
# OCP_AGENT_IMAGE=registry.example.com/your-org/opencode-portal-agent:latest
